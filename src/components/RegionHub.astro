---
import PageHero from './PageHero.astro';
import RegionData from './RegionData.astro';
import ActivityChips from './ActivityChips.astro';
import Forecast7 from './Forecast7.astro';
import { conditions, fmtTime } from '../lib/conditions.js';
import { regionById, hubActivities, spotsIn } from '../lib/catalog.js';
import RegionMap from './RegionMap.astro';
import RegionAlerts from './RegionAlerts.astro';
import { statusStrip } from '../lib/regionview.js';
import LocalSection from './LocalSection.astro';
import { localFor } from '../lib/local.js';
import { NOTES, feedbackMailto } from '../lib/site.js';
import { sunTimes } from '../lib/suntimes.js';

const { id } = Astro.props;
const reg = regionById[id];
const r = conditions.regions[id];
const tz = r.tz;
const tiles = hubActivities(id);
const total = spotsIn(id).length;
const strip = statusStrip(id);
const locals = localFor(id);
const hasFc = (r.forecast?.points ?? []).some((p) => p.days?.length);
const updated = fmtTime(conditions.generatedAt, tz);
const sun = sunTimes(reg.name, tz);
---
<main>
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Idaho</a><span aria-hidden="true"> / </span><strong style="color:var(--ink);font-weight:600">{reg.name} Region</strong></nav>
    <div class="toolbar">
      <PageHero title={`${reg.name} Region.`} lede="Pick an activity below for spots, sources and outbound links." updated={updated} meta={[`${tiles.length} activities · ${total} spots`]} />
      <div class="jump-col">
        <nav class="jump-btns" aria-label="Jump to">
          <a class="jump-btn" href="#activities">Activities <span aria-hidden="true">↓</span></a>
          <a class="jump-btn" href="#alerts">Alerts &amp; conditions <span aria-hidden="true">↓</span></a>
        </nav>
        <p class="jump-sub">
          {hasFc && <a href="#forecast" data-open="forecast">Seven-day forecast <span aria-hidden="true">↓</span></a>}
          {locals.map((l) => <a href={`#${l.domId}`} data-open={l.domId}>{l.linkLabel} <span aria-hidden="true">↓</span></a>)}
          <a href="#readings" data-open="readings">All live readings <span aria-hidden="true">↓</span></a>
        </p>
      </div>
    </div>

    {sun && !sun.none && (
      <p class="sun-line" title="Dusk is the end of civil twilight; full dark is the end of astronomical twilight. Flat-horizon estimates; mountains and canyons lose the sun earlier.">
        <span>Sunrise {sun.sunrise}</span>
        <span>Sunset {sun.sunset}</span>
        {sun.dusk && <span>Dusk {sun.dusk}</span>}
        <span>{sun.fullDark ? `Full dark ${sun.fullDark}` : 'No full dark tonight'}</span>
        <span class="sun-tz">{sun.tzAbbr} <small>(near {sun.near})</small></span>
      </p>
    )}

    <section class="status-strip" aria-label="Regional conditions">
      {strip.map((c) => (
        <article class="status-mini">
          <h2>{c.title}</h2>
          <p class="lead">{c.lead}</p>
          {c.detail && <p class="sub">{c.detail}</p>}
          {c.sub && <p class="sub">{c.sub}</p>}
          {c.links && <p class="sub">{c.links.map((l, i) => <span data-ends={l.ends ?? undefined}><a href={l.href} {...(l.open ? { 'data-open': l.open } : {})} {...(l.href.startsWith('#') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>{l.label}</a>{i < c.links.length - 1 ? ' · ' : ''}</span>)}</p>}
          {c.note && <p class="legal-note">{c.note}</p>}
          <div class="src">{c.src}</div>
        </article>
      ))}
    </section>
    <p class="legal-line">{NOTES.general} <a href="/terms/">Terms</a></p>

    <LocalSection id={id} />

    <div class="section-head sub-lead" id="activities" style="margin-bottom:10px"><h2>Activities</h2><p>Pick one for spots, sources and links.</p></div>
    <ActivityChips region={id} />

    <div class="hub" data-hub>
      <div class="split">
        <RegionMap id={id} regionName={reg.name} regionCode={reg.code} />
        <RegionAlerts id={id} name={reg.name} />
      </div>
    </div>

    <Forecast7 id={id} />
    <RegionData id={id} />
    <p class="feedback-line">See something wrong in the {reg.name} Region, or have a better idea? <a href={feedbackMailto(`${reg.name} Region`)}>Tell the Desk.</a> The mountains won’t answer. We will.</p>
  </div>
</main>

<script>
  // The two quiet links under the jump buttons open their collapsed section as they scroll to it.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[data-open]');
    if (!a) return;
    const d = document.getElementById(a.getAttribute('data-open') ?? '');
    if (d instanceof HTMLDetailsElement) d.open = true;
  });
</script>
