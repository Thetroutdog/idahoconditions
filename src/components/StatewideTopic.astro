---
// One statewide topic page (weather alerts, roads, air quality or fire): every region's items in one place, each linking to its region page.
// Same data the region pages and the landing cards use; nothing new is fetched.
import PageHero from './PageHero.astro';
import AqiValue from './AqiValue.astro';
import UnplacedItems from './UnplacedItems.astro';
import { conditions, regionIds, fmtTime } from '../lib/conditions.js';
import { statewide } from '../lib/statewide.js';
import { roadInfo, fireLinks, forestFireLinks, IDAHO511 } from '../lib/regionview.js';
import { NOTES } from '../lib/site.js';
const { topic } = Astro.props;
const sw = statewide();
const META = {
  weather: { name: 'Weather alerts', lede: 'Every active National Weather Service alert in Idaho, by region.', src: 'National Weather Service', crumb: 'Weather alerts' },
  roads: { name: 'Roads and passes', lede: 'Highway closures, winter road conditions and mountain passes across Idaho, by region.', src: 'Idaho 511', crumb: 'Roads' },
  air: { name: 'Air quality', lede: 'Current air quality readings across Idaho, worst first within each region.', src: 'AirNow (preliminary)', crumb: 'Air quality' },
  fire: { name: 'Fire activity', lede: 'Wildfires and prescribed burns reported in Idaho, by region.', src: 'NIFC', crumb: 'Fire' },
};
const m = META[topic];
const updated = fmtTime(conditions.generatedAt, 'America/Boise');
const clean = (t, n = 160) => { const x = (t ?? '').replace(/\s+/g, ' ').trim(); return x.length <= n ? x : x.slice(0, n).replace(/\s+\S*$/, '') + '…'; };
const until = (a, tz) => (a.ends ? fmtTime(a.ends, tz) : 'further notice');
const sev = (c) => (/closed|impass/i.test(c) ? 0 : /ice|icy|slick/i.test(c) ? 1 : /snow|pack|cover/i.test(c) ? 2 : 3);
// One block per region: {id, name, chip, items:[...]}. Each topic fills `items` with plain objects the template prints.
const blocks = regionIds.map((id) => {
  const r = conditions.regions[id], tz = r.tz;
  const b = { id, name: r.name, items: [], note: '' };
  if (topic === 'weather') {
    b.items = sw.nws.fresh ? r.alerts.map((a) => ({ head: a.event, tail: ` until ${until(a, tz)}${a.countsTowardLevel === false ? ' · part of the region' : ''}`, href: a.url && a.url.includes('MapClick') ? a.url : null })) : [];
    if (!sw.nws.fresh) b.note = 'Out of date. Check the NWS directly.';
  } else if (topic === 'roads') {
    const info = roadInfo(r);
    if (!info.live) b.note = 'Road data is not available right now.';
    b.items = [
      ...info.hwy.map((c) => ({ head: c.name, tag: c.unplanned ? 'Unplanned closure' : 'Planned closure', tagCls: c.unplanned ? 'tag-red' : '', tail: c.description ? `: ${clean(c.description, 110)}` : '' })),
      ...info.passes.filter((p) => p.cond && sev(p.cond) < 3).map((p) => ({ head: p.name, tail: `${p.highway ? ` (${p.highway})` : ''}: ${p.cond}` })),
      ...info.winter.filter((g) => sev(g.condition) < 3).slice(0, 8).map((g) => ({ head: g.name, tail: `: ${g.condition}${g.n > 1 ? ` (${g.n} segments)` : ''}` })),
    ];
  } else if (topic === 'air') {
    b.items = r.air.points.filter((p) => p.aqi?.status === 'fresh' && p.aqi.value !== null).sort((x, y) => y.aqi.value - x.aqi.value).map((p) => ({ head: p.name, aqi: p.aqi.value, tail: p.category ? ` ${p.category}` : '' }));
  } else {
    const fires = r.fire.wildfires.filter((f) => f.status !== 'stale').sort((x, y) => (y.acres ?? 0) - (x.acres ?? 0));
    const burns = r.fire.prescribed.filter((f) => f.status !== 'stale');
    b.items = [
      ...fires.map((f) => ({ head: f.name, tag: 'Wildfire', tail: `${f.county ? `, ${f.county} County` : ''}: ${f.acres ?? '?'} acres${f.containmentPct != null ? `, ${f.containmentPct}% contained` : ''}` })),
      ...burns.map((f) => ({ head: f.name, tag: 'Prescribed burn', tagCls: 'tag-quiet', tail: `${f.county ? `, ${f.county} County` : ''}: ${f.acres ?? '?'} acres` })),
    ];
  }
  return b;
});
const total = blocks.reduce((n, b) => n + b.items.length, 0);
const empty = { weather: 'No active National Weather Service alerts in any region.', roads: 'No highway closures or winter road conditions reported in any region.', air: 'No fresh air-quality readings.', fire: 'No wildfires or prescribed burns reported.' }[topic];
---
<main>
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Idaho</a><span aria-hidden="true"> / </span><strong style="color:var(--ink);font-weight:600">{m.crumb}</strong></nav>
    <PageHero title={`Idaho ${m.name.toLowerCase()}.`} lede={m.lede} updated={updated} meta={[total ? `${total} item${total === 1 ? '' : 's'} statewide` : 'Nothing reported']} />
    <p class="legal-line">{NOTES.general} <a href="/terms/">Terms</a></p>
    {total === 0 && <div class="all-clear" style="margin-top:12px"><strong>{empty}</strong></div>}
    <UnplacedItems items={sw.unplaced[topic]} />
    {topic === 'roads' && <p class="quiet" style="margin:10px 0 0">Passes and roads listed here have a reported snow, ice or closure condition. For the live map, cameras and every pass, open <a href={IDAHO511} target="_blank" rel="noopener noreferrer">Idaho 511</a>.</p>}
    {topic === 'fire' && <p class="quiet" style="margin:10px 0 0">More fire info: {fireLinks('none').map((l, i, a) => <><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>{i < a.length - 1 ? ' · ' : ''}</>)}</p>}
    <section class="alerts-sec" style="margin-top:14px" aria-label={`${m.name} by region`}>
      {blocks.map((b) => (
        <article class="alert-card">
          <h3><a href={`/${b.id}/`}>{b.name} Region</a></h3>
          {b.note && <p class="quiet">{b.note}</p>}
          {b.items.length > 0 ? (
            <ul>{b.items.map((x) => (
              <li>
                {x.href ? <a href={x.href} target="_blank" rel="noopener noreferrer"><strong>{x.head}</strong></a> : <strong>{x.head}</strong>}
                {x.aqi != null && <> <AqiValue value={x.aqi} /></>}
                {x.tag && <> <span class={`tag ${x.tagCls ?? ''}`}>{x.tag}</span></>}
                {x.tail}
              </li>
            ))}</ul>
          ) : !b.note && <p class="quiet">None reported.</p>}
          {topic === 'fire' && forestFireLinks(b.id).length > 0 && <p class="quiet fire-links">Local info: {forestFireLinks(b.id).map((l, i, a) => <><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>{i < a.length - 1 ? ' · ' : ''}</>)}</p>}
        </article>
      ))}
    </section>
    <div class="src" style="margin-top:10px">{m.src}</div>
    <p class="quiet" style="margin:6px 0 0">Open a region for its full detail, forecasts and sources.</p>
  </div>
</main>
