# Keep the Cloudflare Pages addresses out of search results once the site is indexable. The .com site is the one that should be indexed
# (every page's canonical link points there). These two rules cover idahoconditions.pages.dev and the preview/branch addresses; the custom
# domain is not matched. Cloudflare serves this file as headers and does not publish it.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# The monitoring copy of the data (written to dist/data by scripts/publish_monitor.py): not for search results, and fine to cache for a few minutes.
/data/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=300
